    "type": "git",
    "url": "https://github.com/Houseofmvps/ultraship"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude",
    "seo",
    "geo",
    "aeo",
    "lighthouse",
    "security",
    "code-review",
    "deploy",
    "indie-hacker",
    "saas",
    "ai",
    "developer-tools",
    "performance",
    "browser-testing",
    "workflow",
    "competitive-analysis",
    "launch",
    "incident-response",
    "growth",
    "cost-tracking",
    "onboarding",
    "architecture",
    "visual-regression",
    "demo"
  ],
  "files": [
    "bin/",
    ".claude-plugin/",
    "skills/",
    "agents/",
    "commands/",
    "tools/",
    "hooks/",
    "assets/",
